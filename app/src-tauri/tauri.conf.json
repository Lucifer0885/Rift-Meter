{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Riftmeter",
  "version": "0.5.18",
  "identifier": "dev.dsodpsmeter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Riftmeter",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Riftmeter Overlay",
        "width": 300,
        "height": 160,
        "x": 40,
        "y": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Lucifer0885",
    "shortDescription": "Passive DPS meter for Drakensang Online",
    "copyright": "Copyright (c) 2026 Lucifer0885. MIT License.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQTExOTU4RTMzOTM4QkQKUldTOU9EbmpXQm1oNjg3cFVtQVZpSFRNQ2hOcmlQdG96YzV1N3lwS21UaVdkZHVTdG0yZzRGS2IK",
      "endpoints": [
        "https://github.com/Lucifer0885/Rift-Meter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
