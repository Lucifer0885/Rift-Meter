{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Riftmeter",
  "version": "0.5.18",
  "identifier": "dev.dsodpsmeter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Riftmeter",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Riftmeter Overlay",
        "width": 300,
        "height": 160,
        "x": 40,
        "y": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
